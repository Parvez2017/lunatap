# ==============================================================================
# Lunatap Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# LLM Providers (Configure at least one)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Model selection (optional). Gemini is the default; to run every agent on
# OpenAI or an OpenAI-compatible server, pick a preset from config/artemis.jsonc:
#   LUNATAP_LLM_PRESET=openai              # needs OPENAI_API_KEY
#   LUNATAP_LLM_PRESET=openai-compatible   # needs OPENAI_BASE_URL + LUNATAP_LLM_MODEL
#   LUNATAP_LLM_PRESET=local-ollama        # Ollama on this machine
# LUNATAP_LLM_PRESET=
# LUNATAP_LLM_MODEL=             # overrides the preset's model
# LUNATAP_LLM_FALLBACK_MODEL=    # defaults to LUNATAP_LLM_MODEL
# OPENAI_BASE_URL=               # e.g. https://openrouter.ai/api/v1, http://localhost:1234/v1
# OLLAMA_BASE_URL=               # default http://localhost:11434/v1

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
OCR_API_KEY=

# Execution Defaults (flash or pro)
LUNATAP_DEFAULT_PROFILE=flash
